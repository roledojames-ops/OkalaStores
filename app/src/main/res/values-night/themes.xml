<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OkalaStores" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.OkalaStores.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_red_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OkalaStores</item>
    </style>
</resources>
